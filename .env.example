# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...clave-anon-publica
# CLAVE PRIVADA: solo servidor. Nunca la pongas en el navegador ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...clave-service-role

# --- Sitio ---
# URL pública final (para armar los enlaces privados de cada turno). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para anonimizar las IP en el límite de solicitudes (cualquier texto largo y aleatorio)
RATE_LIMIT_SALT=cambia-esto-por-un-texto-aleatorio
