{
  "name": "don-gabo-barber-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Reservas de turnos y panel de administración para DON GABO BARBER STUDIO",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db --no-file-parallelism",
    "test:e2e": "playwright test",
    "stack:up": "bash scripts/local-stack.sh up",
    "stack:down": "bash scripts/local-stack.sh down",
    "create-admin": "node scripts/create-admin.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}